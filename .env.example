# Optional. docker-compose.yml has a default for every key below.
# Copy to .env only to override one: cp .env.example .env
# See .ai/context/stack.md for what each key means.

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=app
POSTGRES_USER=django
POSTGRES_PASSWORD=secret

# Docker build (host UID/GID so bind-mounted files aren't root-owned)
USER_ID=1000
GROUP_ID=1000
