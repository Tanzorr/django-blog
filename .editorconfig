# editorconfig.org
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,ts,css,scss,json}]
indent_size = 2

[*.html]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml,toml}]
indent_size = 2

[{,docker-}compose{,.*}.{yaml,yml}]
indent_size = 2

[*.sh]
indent_style = tab

[{,*.*}Dockerfile]
indent_style = tab
